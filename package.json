        "node-vibrant": "4.0.4",
        "notistack": "3.0.2",
        "p-limit": "7.3.3",
        "polished": "4.3.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-hotkeys-hook": "5.4.0",
        "react-lazily": "0.9.2",
        "react-router-dom": "6.26.1",
        "react-virtuoso": "4.18.24",
        "rxjs": "7.8.2",
        "stylis": "4.4.0",
        "stylis-plugin-rtl": "2.1.1",
        "use-long-press": "3.3.0",
        "use-query-params": "2.2.2",
        "webfontloader": "1.6.28",
        "zustand": "5.1.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.8",
        "@graphql-codegen/cli": "7.2.0",
