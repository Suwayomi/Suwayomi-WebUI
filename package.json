{
    "name": "project",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "setup-env-files": "bun tools/scripts/setupEnvFiles.ts",
        "setup": "bun install --frozen-lockfile && bun run setup-env-files",
        "dev": "bun run setup && vite",
        "preview": "bun run setup && vite preview",
        "build": "bun run setup && vite build",
        "test": "bun test",
        "build-md5": "find build -type f | sort | xargs md5sum | awk '{ print $1 }' | tr -d '\n' | md5sum| awk '{ print $1 }' > buildZip/md5sum ",
        "build-zip": "cd build && rev=$(git rev-list HEAD --count) && echo r$rev > revision && zip -9 -r ../buildZip/Suwayomi-WebUI-r$rev *",
        "lint": "biome lint --error-on-warnings && bun tools/scripts/checkLicenseHeader.ts",
        "format": "biome format --write",
        "format:check": "biome format",
        "createCommitChangelog": "bun tools/scripts/release/createCommitChangelog.ts",
        "createReleaseChangelog": "bun tools/scripts/release/createReleaseChangelog.ts",
        "updateDeps": "bun tools/scripts/updateDependencies.ts",
        "gql:codegen-base": "graphql-codegen --config gql_codegen.ts",
        "gql:codegen-formatter": "bun tools/scripts/codegenFormatter.ts",
        "gql:codegen": "bun run gql:codegen-base && bun run gql:codegen-formatter && bun run format",
        "i18n:extract": "lingui extract --locale en --clean",
        "dayjs:gen-locales-array": "bun tools/scripts/dayjs/generateDayJsLocales.ts",
        "dayjs:gen-locales-import": "bun tools/scripts/dayjs/generateDayJsLocalesImport.ts",
        "dayjs:gen-locales": "bun run dayjs:gen-locales-array && bun run dayjs:gen-locales-import",
        "tsc": "tsgo",
        "tsc:legacy": "tsc",
        "prepare": "husky"
    },
    "dependencies": {
        "@apollo/client": "4.3.8",
        "@dnd-kit/core": "6.3.1",
        "@dnd-kit/sortable": "10.0.0",
        "@dnd-kit/utilities": "3.2.2",
        "@emotion/cache": "11.14.0",
        "@emotion/react": "11.14.0",
        "@emotion/styled": "11.14.1",
        "@juggle/resize-observer": "3.4.0",
        "@lingui/core": "6.12.0",
        "@lingui/react": "6.12.0",
        "@loadable/component": "5.16.7",
        "@mantine/hooks": "9.8.2",
        "@mui/icons-material": "9.5.0",
        "@mui/material": "9.5.0",
        "@mui/system": "9.5.0",
        "@mui/utils": "9.5.0",
        "@mui/x-date-pickers": "9.18.0",
        "@redux-devtools/extension": "4.0.1",
