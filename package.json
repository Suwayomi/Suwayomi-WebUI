        "@tiptap/markdown": "3.30.2",
        "@tiptap/starter-kit": "3.30.2",
        "@vibrant/color": "4.0.4",
        "apollo-upload-client": "20.0.0",
        "awaitable-component": "1.0.0",
        "colorthief": "3.5.0",
        "csstype": "3.2.4",
        "dayjs": "1.11.23",
        "dompurify": "3.4.18",
        "fast-average-color": "9.6.0",
        "file-selector": "5.0.3",
        "fuse.js": "7.5.0",
        "graphql": "17.1.0",
        "graphql-sock": "1.0.1",
        "graphql-tag": "2.12.7",
        "graphql-ws": "6.4.3",
        "immer": "11.2.10",
