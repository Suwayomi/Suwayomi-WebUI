        "@lingui/vite-plugin": "6.12.0",
        "@swc/core": "1.15.11",
        "@types/bun": "1.4.5",
        "@types/lodash": "4.17.27",
        "@types/node": "24.10.1",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/stylis": "4.2.7",
        "@types/webfontloader": "1.6.38",
        "@types/yargs": "17.0.35",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "@vitejs/plugin-legacy": "8.2.4",
        "@vitejs/plugin-react-swc": "4.3.3",
        "dotenv": "17.4.2",
        "husky": "9.1.7",
        "lint-staged": "17.6.1",
        "terser": "5.51.4",
        "typescript": "6.0.3",
        "vite": "8.0.14",
        "vite-plugin-node-polyfills": "0.28.0",
        "vite-plugin-pwa": "1.3.0",
        "workbox-build": "7.4.1",
        "workbox-window": "7.4.1",
        "yargs": "18.2.0"
    },
    "engines": {
        "bun": ">=1.4.5"
    },
    "packageManager": "bun@1.4.5",
    "overrides": {
        "@swc/core": "1.15.11"
    },
    "trustedDependencies": [
        "@swc/core",
